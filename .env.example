# Copy to .env and fill in. Never commit .env.
# Read in one place only: core/settings.py (added in Phase 1).
# For now this file also names the one project Brigade works on: change the values in the
# "Project" section to switch project. Later these move to the database.
 
# --- Credentials (secrets) ---
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional, needed only for push / pull request (Phase 8)
BRIGADE_GITHUB_TOKEN=
 
# --- Jira site ---
JIRA_SITE_URL=https://your-site.atlassian.net

# --- Project (the one Brigade works on) ---
# jira or github
BRIGADE_TRACKER=jira
# The Jira space key, e.g. SM
JIRA_PROJECT_KEY=
# GitHub owner/name of the project's repository. Leave empty for a local-only project.
BRIGADE_REPOSITORY=
# Full path of the project's local clone or folder
BRIGADE_PROJECT_PATH=
BRIGADE_BASE_BRANCH=main
# Optional. Name shown in the project selector. Empty = repository name, else folder name.
BRIGADE_PROJECT_NAME=
 
# --- Where things live ---
# Central database folder (holds brigade.db for all projects). Default: ~/.agent-brigade
BRIGADE_DATA_DIR=
# Folder for git worktrees, outside every project
BRIGADE_WORKTREE_ROOT=
 
# --- Limits ---
# Retries after a failed attempt, 0 to 5
BRIGADE_MAX_RETRIES=2
# Sub-tasks running at once, 1 to 8
BRIGADE_MAX_PARALLEL=3
# Seconds one test run may take, 60 to 86400
BRIGADE_TEST_TIMEOUT=1200