// Agent Brigade - database schema (11 tables)
// Paste into https://dbdiagram.io/d to see the diagram.
// See docs/adr/0001 for the central database.

Project agent_brigade {
  database_type: 'SQLite'
  Note: 'One central file for all projects: <BRIGADE_DATA_DIR>/brigade.db (default ~/.agent-brigade/)'
}

// ---------- Project ----------

Table projects {
  id integer [pk, increment]
  name varchar [not null]
  repository varchar [note: 'owner/repo']
  local_path varchar [not null]
  base_branch varchar [not null]
  Note: 'The connected project'
}

// ---------- Board (local copy of the tracker) ----------

Table tracker_items {
  key varchar [pk, note: 'Jira key, or GitHub issue number']
  project_id integer [not null]
  type varchar [not null, note: 'epic | story | sub-task']
  parent_key varchar [note: 'epic of a story, story of a sub-task']
  summary varchar [not null]
  status varchar
  synced_at timestamp
  Note: 'Local copy of the board; overwritten by Sync from Jira'
}


// ---------- Publisher ----------

Table chat_sessions {
  id integer [pk, increment]
  project_id integer [not null]
  claude_session_id varchar [not null]
  created_at timestamp
  Note: 'Publisher conversations'
}

Table publish_records {
  id integer [pk, increment]
  chat_session_id integer [not null]
  proposed_items json
  confirmed_at timestamp
  created_keys varchar
  Note: 'What was written to Jira and when'
}

// ---------- Planning and building ----------

Table story_runs {
  id integer [pk, increment]
  project_id integer [not null]
  story_key varchar [not null]
  run_id varchar [unique, note: 'the plan run id, e.g. SMT-56-20261112-a3f9; the approved one is the story run']
  status varchar [not null, note: 'planning | waiting | approved | superseded | failed']
  branch varchar
  plan_file varchar [note: 'path to plan.json']
  error text [note: 'why a run failed']
  budget decimal
  cost decimal
  started_at timestamp
  ended_at timestamp
  Note: 'One story planning and build'
}

Table sub_tasks {
  id integer [pk, increment]
  story_run_id integer [not null]
  key varchar [not null, note: 'points to tracker_items; title and acceptance criteria are read from there']
  status varchar [not null, note: 'queued | running | blocked | stopped | done | error']
  depends_on varchar [note: 'comma separated keys']
  size varchar
  current_stage varchar
  Note: 'One sub-task state inside a story run'
}

Table attempts {
  id integer [pk, increment]
  sub_task_id integer [not null]
  number integer [not null]
  branch varchar [note: 'agent-attempt/<run_id>/<KEY>-<n>']
  working_copy varchar [note: 'Git worktree path']
  outcome varchar
  reason varchar
  started_at timestamp
  ended_at timestamp
  Note: 'One try at a sub-task (under review: may be folded into agent_runs)'
}

Table agent_runs {
  id integer [pk, increment]
  attempt_id integer [not null]
  role varchar [not null, note: 'builder | tester | reviewer | planner | documenter']
  model_requested varchar
  model_used varchar
  effort varchar
  turns integer
  input_tokens integer
  output_tokens integer
  cache_tokens integer
  cost decimal
  duration_s integer
  exit_reason varchar
  session_id varchar [note: 'Claude session id']
  status varchar [note: 'running | done | error']
  started_at timestamp
  ended_at timestamp
  Note: 'One Claude Code session'
}

Table checks {
  id integer [pk, increment]
  attempt_id integer [not null]
  kind varchar [not null, note: 'scope | tests | combined tests']
  passed boolean [not null]
  output_tail varchar
  Note: 'Facts the orchestrator measured'
}

Table merges {
  id integer [pk, increment]
  attempt_id integer [not null]
  kind varchar [not null, note: 'fast-forward | real']
  commit varchar
  tests_passed boolean
  merged_at timestamp
  Note: 'Every merge into a story branch'
}

Table budget_reservations {
  id integer [pk, increment]
  story_run_id integer [not null]
  agent_run_id integer
  amount decimal [not null]
  released boolean [default: false]
  Note: 'Money held for running agents'
}

// ---------- Relationships ----------

Ref: tracker_items.project_id > projects.id
Ref: story_runs.project_id > projects.id
Ref: chat_sessions.project_id > projects.id
Ref: publish_records.chat_session_id > chat_sessions.id

Ref: story_runs.story_key > tracker_items.key
Ref: sub_tasks.key > tracker_items.key
Ref: tracker_items.parent_key > tracker_items.key

Ref: sub_tasks.story_run_id > story_runs.id
Ref: attempts.sub_task_id > sub_tasks.id
Ref: agent_runs.attempt_id > attempts.id
Ref: checks.attempt_id > attempts.id
Ref: merges.attempt_id > attempts.id

Ref: budget_reservations.story_run_id > story_runs.id
Ref: budget_reservations.agent_run_id - agent_runs.id
